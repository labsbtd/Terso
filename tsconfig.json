{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": { "@labsbtd/terso": ["./src/index.ts"] },
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": [
    "src",
    "tests",
    "examples",
    "tsup.config.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
